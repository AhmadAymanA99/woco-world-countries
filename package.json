{
  "name": "woco-world-countries",
  "version": "1.0.0",
  "description": "World Countries (WoCo) - A MERN SaaS application for exploring countries and tracking visits",
  "scripts": {
    "start": "node client/server.js",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "nodemon client/server.js",
    "client": "cd client && npm start",
    "build": "cd client && npm run build"
  },
  "keywords": ["countries", "travel", "saas", "mern", "react", "node"],
  "author": "WoCo Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.0",
    "nodemon": "^3.0.1"
  }
}
